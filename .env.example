NEXT_PUBLIC_SUPABASE_URL=https://project-id.supabase.co/
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=supbase-publishable-key
HS_API_BASE_URL=http://localhost:8080

# Lets the backend expire the stats caches after a website lead or booking
# request (POST /api/revalidate). Same value as the backend's
# PUBLIC_REVALIDATE_SECRET; leave empty to keep the endpoint off.
REVALIDATE_SECRET=

# Read by .npmrc to install @hscowork/service-generator from GitHub Packages.
# A personal access token with read:packages. Put the real value in .env.
NPM_GITHUB_TOKEN=your-github-packages-token
