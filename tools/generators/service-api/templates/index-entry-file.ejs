<%
const { config, routes, utils } = it;
const { _, getInlineParseContent } = utils;
const { RESERVED_REQ_PARAMS_ARG_NAMES } = config.constants;

const primitives = ['string', 'number', 'boolean', 'Array<string>', 'Array<number>', 'Array<boolean>'];

const maybeGetUsage = (method, name) => {
    if(method.toUpperCase() !== 'GET') {
        return name;
    }

    return `get${_.upperFirst(name.replace(/^get/i, ''))}`;
}

const getTypesForImport = () => {
    const types = new Set();

    routes.combined && routes.combined.forEach(({ routes = [], moduleName }) => {
        routes.forEach((route) => {
            const { specificArgNameResolver } = route;
            const { parameters, payload, query, requestParams } = route.request;
            const queryName = (query && query.name) || "query";
            const pathParams = _.values(parameters);
            const pathParamsNames = _.map(pathParams, 'name');

            const rawWrapperArgsWithoutRequestParams =
                _.compact([
                    requestParams && {
                    name: pathParams.length ? `{ ${_.join(pathParamsNames, ", ")}, ...${queryName} }` : queryName,
                    optional: false,
                    type: getInlineParseContent(requestParams),
                    },
                    ...(!requestParams ? pathParams : []),
                    payload
                ])

            const wrapperTypes = _
                // Sort by optionality
                .sortBy(rawWrapperArgsWithoutRequestParams, [o => o.optional])
                .filter(({ type }) => !primitives.includes(type))
                .map(({ type }) => type)

                wrapperTypes.forEach(type => types.add(type))
        })
    })

    return [...types]
}

const getAllTypes = () => {
  const allTypes = []
  if(!routes.combined) return [];


  routes.combined.forEach(({ routes = [] }) => {
    routes.forEach((route) => {
        const type = getInlineParseContent(route.request.requestParams);
        if(!primitives.includes(type)) allTypes.push(type);
    })
  })

  return allTypes;
}
%>

'use server'
import 'server-only'
import { <%~ _.lowerFirst(config.apiClassName) %> } from './api'
<% if(getTypesForImport().length) { %>
import type { <%~ getTypesForImport().join(', ') %> } from './<%~ config.apiClassName %>'
<% } %> 
import type { RequestParams } from '../shared/types'

<% routes.combined && routes.combined.forEach(({ routes = [], moduleName }) => { %>
    <% routes.forEach((route) => { %>

        <%
        const { specificArgNameResolver } = route;
        const { parameters, payload, query, requestParams } = route.request;
        const queryName = (query && query.name) || "query";
        const pathParams = _.values(parameters);
        const pathParamsNames = _.map(pathParams, 'name');

        const argToTmpl = ({ name, optional, type, defaultValue }) => `${name}${!defaultValue && optional ? '?' : ''}: ${type}${defaultValue ? ` = ${defaultValue}` : ''}`;

        const rawWrapperArgsWithoutRequestParams =
            _.compact([
                requestParams && {
                name: pathParams.length ? `{ ${_.join(pathParamsNames, ", ")}, ...${queryName} }` : queryName,
                optional: false,
                type: getInlineParseContent(requestParams),
                },
                ...(!requestParams ? pathParams : []),
                payload
            ])

        let wrapperArgs = _
            // Sort by optionality
            .sortBy(rawWrapperArgsWithoutRequestParams, [o => o.optional])
            .map(argToTmpl)
            .join(', ')
        const functionWrapperArgs = wrapperArgs?.length ? `${wrapperArgs}, ` : ''

        const callerArgs = _
            // Sort by optionality
            .sortBy(rawWrapperArgsWithoutRequestParams, [o => o.optional])
            .map(({ name }) => name)
            .join(', ')
            const functionCallerArgs = callerArgs?.length ? `${callerArgs}, ` : ''
        %>

        export async function <%~ maybeGetUsage(route.request.method, route.routeName.usage) %>(<%~ functionWrapperArgs %>params?: RequestParams) {
            return <%~ _.lowerFirst(config.apiClassName) %>.<%~ moduleName %>.<%~ route.routeName.usage %>(<%~ functionCallerArgs %>params)
        }

    <% }) %>
<% }) %>
